{
  "name": "briarbridge-alchemy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test backend/*.test.ts",
    "jev:probe": "node scripts/jev-probe.ts",
    "dev": "vite",
    "api": "cargo run -p alchemy-sandbox --bin game-api",
    "build": "tsc -p web/tsconfig.json && vite build",
    "preview": "vite preview",
    "test:web": "playwright test",
    "test:ownership": "playwright test --config playwright.owned.config.ts",
    "dev:ownership": "node scripts/player-owned-preview.ts",
    "assets:playtest": "node scripts/build-stasho.ts --assets-only",
    "build:stasho": "node scripts/build-stasho.ts"
  },
  "dependencies": {
    "@near-js/crypto": "2.5.1",
    "@near-js/transactions": "2.5.1",
    "@near-js/utils": "2.5.1",
    "@supabase/supabase-js": "2.118.0",
    "borsh": "1.0.0",
    "buffer": "6.0.3",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "supabase": "3.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/san-npm/copper-acorn.git"
  }
}
